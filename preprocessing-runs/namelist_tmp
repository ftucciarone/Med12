   sn_qsr      = 'ERA5_swrd',   24.     , 'swrd'  ,   .false., .false., 'monthly','weights_ERA5-MED7km_bilin.nc' , ''       , ''
   sn_qlw      = 'ERA5_lwrd',   24.     , 'lwrd'  ,   .true. , .false., 'monthly','weights_ERA5-MED7km_bilin.nc' , ''       , ''
   sn_tair     = 'ERA5_t2m' ,    1.     , 't2m'   ,   .true. , .false., 'monthly','weights_ERA5-MED7km_bilin.nc' , ''       , ''
   sn_humi     = 'ERA5_q2m' ,    1.     , 'q2m'   ,   .true. , .false., 'monthly','weights_ERA5-MED7km_bilin.nc' , ''       , ''
   sn_prec     = 'ERA5_precip', 24.     , 'precip',   .true. , .false., 'monthly','weights_ERA5-MED7km_bilin.nc' , ''       , ''
   sn_snow     = 'ERA5_snow',   24.     , 'snow'  ,   .true. , .false., 'monthly','weights_ERA5-MED7km_bilin.nc' , ''       , ''
   sn_slp      = 'ERA5_slp' ,    1.     , 'slp'   ,   .true. , .false., 'monthly','weights_ERA5-MED7km_bilin.nc' , ''       , ''
   sn_tdif     = 'NOT USED'  ,   24.     , 'taudif',   .false., .true. , 'yearly','weights_ERA5-MED7km_bilin.nc' , ''       , ''
