# Makefile for SOSIE with Intel Ifort on Linux
# ============================================

# Fortran compiler:
FC = /usr/bin/mpif90

# Root directory for Netcdf:
NETCDF_DIR = /home/ftucciar/nemo-dep/installs -I/home/ftucciar/nemo-dep/installs

# Linking argument: usually -lnetcdf or -lnetcdff (or both):
L_NCDF = -L/home/ftucciar/nemo-dep/installs/lib -lnetcdff -Wl,-rpath,/home/ftucciar/nemo-dep/installs/lib -L/home/ftucciar/nemo-dep/installs/lib -lnetcdf -lhdf5_hl -lhdf5 -lz -lcurl -lnetcdf -lnetcdf -ldl -lm -lmpi

# Fortran compilation flags:

##EXTRA_DEBUG_FLAGS = -g -check all -fpe0 -warn all -traceback -debug extended -C

FF = -Ofast -fbounds-check -Wno-uninitialized -ffree-line-length-512 $(EXTRA_DEBUG_FLAGS) -J./mod/

# Directory to install binaries:
INSTALL_DIR = /usr/local
